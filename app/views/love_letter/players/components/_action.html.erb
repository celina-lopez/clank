<%
  label = case key
  when 'victory_points'
    'Victory'
  when 'favor_tokens'
    "Favor Tokens"
  when 'removed_from_round'
    'Removed from Round'
  else
    nil
  end
%>
<div>
  <% if label %>
    <%= render 'love_letter/players/components/icon_action', key:, value:%>
    <%= label %>
  <% else %>
    <%= key.humanize %>
  <% end %>
</div>
