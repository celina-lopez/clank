<%
  label = local_assigns[:label] || ''
  onclick = local_assigns[:onclick] || 'executeAction(this)'
  action_type = local_assigns[:action_type] || '' 
  element_name = action_type.presence || local_assigns[:element_name] || ''
%>

<div id="<%= element_name %>" class="<%= player[player_trait].positive? ? '' : action_type.present? ? 'hidden' : '' %>">
  <div><%= label %></div>
  <div class="flex flex-row gap-2">
    <% players.each do |p| %>
      <div class="z-10" id="<%= element_name%>-<%= p['index'] %>">
        <div
          class="rounded-full trigger-button bg-red-100 border-black border-2 rounded h-[50px] w-[50px] cursor-pointer"
          onclick="<%= onclick %>"
          data-type="<%= action_type %>"
          data-name="<%= p['index'] %>"
        >
          <img src='<%= "/images/profile-#{p['index']}.png" %>' class="rounded-full w-[50px]" />
        </div>
        <%= p['name'] %>
      </div>
    <% end %>
  </div>
</div>
