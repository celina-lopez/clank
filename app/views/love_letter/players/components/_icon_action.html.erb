<%
  with_prefix = false if local_assigns[:with_prefix].nil?
  value = local_assigns[:value]
  case key
  when 'skill_points'
    icon = 'wand-sparkles'
    color = 'sky'
  when 'victory_points'
    icon = 'face-smile'
    color = 'green'
  when 'health'
    icon = 'heart'
    color = 'red'
  else
    icon = nil
    color = nil
  end
%>
<% if icon %>
  <i class="text-<%= color %>-600 fa-solid fa-<%= icon %>"></i>
  <% if with_prefix %>
    <%= value.positive? ? "+#{value}" : value %>
  <% else %>
    <%= value %>
  <% end %>
<% end %>
