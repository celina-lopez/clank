<%
  value = local_assigns[:value]
  case key
  when 'victory_points'
    icon = 'face-smile'
    color = 'green'
  when 'favor_tokens'
    icon = 'heart'
    color = 'red'
  when 'removed_from_round'
    icon = 'face-sad-cry'
    color = 'sky'
  else
    icon = nil
    color = nil
  end
%>
<% if icon %>
  <i class="text-<%= color %>-600 fa-solid fa-<%= icon %>"></i>
  <%= value == true ? '' : value %>
<% end %>
