<% 
  color = @phaser_config.dig('player_colors', player['index'].to_i)
%>
<div class="mt-2 max-w-fit border-2 border-<%= color %>-400 p-3 rounded-lg mt-2"">
  <div class="<%= player['index'] == game['current_player_index'] ? 'hidden' : '' %>" id="helper_text">
    <% if player['keep_card_points'].positive? %>
      Choose a card to keep in hand
    <% else %>
      Choose a card to play
    <% end %>
  </div>
  <div class='my-3 flex gap-3 ' id='player-cards'>
    <% player.dig('deck', 'active').each do |card| %>
      <%= render(
        'players/components/card',
        card:,
        data_type: player['keep_card_points'].positive? ? 'keep_card' : card['name'],
        data_name: player['keep_card_points'].positive? ? card['name'] : nil,
        button_text: 'play',
        game_prefix: "love_letter"
      ) %>
    <% end %>
  </div>
  <%= render "love_letter/players/partials/player", player:, game:, phaser_config: @phaser_config, with_border: false %> 
</div>
