<% 
  color = @phaser_config.dig('player_colors', player['index'].to_i)
%>
<div class="mt-2 max-w-fit border-2 border-<%= color %>-400 p-3 rounded-lg mt-2"">
  <%= render "love_letter/players/partials/player", player:, game:, phaser_config: @phaser_config, with_border: false %> 
  <div class="<%= player['index'] == game['current_player_index'] ? 'hidden' : '' %>" id="helper_text">
    <% if player['keep_card_points'].positive? %>
      Choose a card to keep in hand
    <% else %>
      Choose a card to play
    <% end %>
  </div>
  <div class='my-3 flex gap-3 ' id='player-cards'>
    <% player.dig('deck', 'active').each do |card| %>
      <%= render(
        'players/components/card',
        card:,
        data_type: player['keep_card_points'].positive? ? 'keep_card' : card['name'],
        data_name: player['keep_card_points'].positive? ? card['name'] : nil,
        button_text: 'play',
        game_prefix: "love_letter"
      ) %>
    <% end %>
  </div>

  <div class="max-w-fit border rounded p-5 border-primary <%= player['revealed_card_to_player'].present? ? '' : 'hidden' %>" id='revealed_card'>
    <div>Revealed Card</div>
    <div id='revealed_card-container'>
      <% if player['revealed_card_to_player'].present? %>
        <img src="/images/profile-<%= player['revealed_card_to_player']['index'] %>.png" class="rounded-full border-<%= @phaser_config.dig('player_colors', player['revealed_card_to_player']['index'].to_i) %>-400 border-2 rounded h-[75px] w-[75px]"/>
        <div class="text-sm"><%= game.data['players'].find { |p| p['index'] == player['revealed_card_to_player']['index'] }['name'] %></div>
        <div id='revealed_card-cards'>
          <%= render(
            'players/components/card',
            card: player['revealed_card_to_player']['card'],
            game_prefix: 'love_letter'
          ) %>
        </div>
      <% end %>
    </div>
  </div>
</div>
