<div id='player-stats-<%= player['index'] %>'> 
  <img
    src="/images/profile-<%= player['index'] %>.png"
    class="rounded-full border-<%= phaser_config.dig('player_colors', player['index'].to_i) %>-400 border-2 rounded h-[75px] w-[75px] <%= player['removed_from_round'] && 'opacity-50' %>"
  />
  <%= render 'love_letter/players/components/favor_tokens', game:, player: %>
  <div class="flex">
    <% player['deck']['discarded'].each do |card| %>
      <div class="w-6">
        <%= render(
          'players/components/info_card',
          card:,
          small_card: true,
          game_prefix: 'love_letter'
        ) %>
      </div>
    <% end %>
  </div>
</div>
