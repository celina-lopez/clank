<div class="navbar bg-base-100">
  <a class="btn btn-ghost text-xl" href='/'><img src='/images/logo.png' width='30' />PlayBoard.Games</a>
  <!-- Not toggled switch -->
  <div class="w-full h-full flex flex-col justify-center items-center">
    <div class="flex justify-center items-center ml-auto">
      <span>
        <svg class="h-6 w-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </span>
      <input type="checkbox" class="toggle mx-1" checked="checked" />
      <span>
        <svg class="h-6 w-6 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
      </span>
    </div>
  </div>
</div>
<script>
  const toggle = document.querySelector('.toggle');
  const html = document.querySelector('html');
  toggle.addEventListener('click', () => {
    if (html.dataset.theme === 'fantasy') {
      html.dataset.theme = 'dracula';
      // save to local storage
      localStorage.setItem('theme', 'dracula');
    } else {
      html.dataset.theme = 'fantasy';
      localStorage.setItem('theme', 'fantasy');
    }
  });

  // get the theme from local storage
  const theme = localStorage.getItem('theme');
  if (theme) {
    html.dataset.theme = theme;
  }
</script>
