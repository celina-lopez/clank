<meta property="og:url"           content="<%= root_url %>" />
<meta property="og:type"          content="website" />
<meta property="og:title"         content="PlayBoard.Games" />
<meta property="og:image"         content="<%= image_url('/images/metadata_image.png') %>" />
<meta name="title" content="PlayBoard.Games">
<meta name="description" content="Start with our first game and stay tuned for more thrilling games coming soon! Join us for endless fun and strategy.">
<meta name="keywords" content="boardgames,clank,aeons end,online games,free">
<meta name="robots" content="index, follow">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<meta name="language" content="English">
<meta name="revisit-after" content="10 days">
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="PlayBoard.Games" />
<meta name="twitter:image" content="<%= image_url('/images/metadata_image.png') %>" />

<% if controller.controller_name == 'player' %>
  <meta name="twitter:description" content="I just played Clank! Check out my results and see how I fared in this exciting adventure. Discover the outcome of my game and share your own results!" />
  <meta property="og:description"   content="I just played Clank! Check out my results and see how I fared in this exciting adventure. Discover the outcome of my game and share your own results!" />
<% else %>
  <meta name="twitter:description" content="Start with our first game and stay tuned for more thrilling games coming soon! Join us for endless fun and strategy." />
  <meta property="og:description"   content="Start with our first game and stay tuned for more thrilling games coming soon! Join us for endless fun and strategy." />
<% end %>
