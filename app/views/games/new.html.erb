<%= form_with(model: @game, local: true) do |form| %>
  <h1 class="text-2xl font-bold">
    <%= params.fetch(:game_type, 'clank').humanize %>
  </h1>
  <label class="form-control w-full max-w-xs">
    <div class="label">
      <span class="label-text">Name of game</span>
    </div>
    <%= form.text_field :title, required: true, class: "input input-bordered w-full max-w-xs", value: RandomNameGenerator.game_name %>
  </label>
  <% game_type = params.fetch(:game_type, 'clank') %>
  <%= render "#{game_type}/players/partials/form" %>

  <%= form.hidden_field :game_type, value: game_type %>

  <div class="actions mt-3">
    <script>
      function addPlayerBtn() {
        let clone = document.importNode(document.getElementById('addPlayerForm').content, true)
        clone.querySelector('input').setAttribute('value', `Player ${document.querySelectorAll('input[name="game[players][]"]').length}`)
        clone.querySelector('input').setAttribute('value', generateName());
        document.getElementById('playerContainer').appendChild(clone);
        if (document.querySelectorAll('input[name="game[players][]"]').length == 6) {
          document.getElementById('addPlayerBtn').classList.add('hidden');
        }
      };
      window.addEventListener('load', function() {
        document.getElementById('addPlayerBtn').addEventListener('click', addPlayerBtn);
      });
    </script>
    <button  type="button" id="addPlayerBtn" class="my-2 btn btn-primary btn-outline">Add Player</button>
    <%= form.submit class: "btn btn-active btn-primary" %>
  </div>
<% end %>
