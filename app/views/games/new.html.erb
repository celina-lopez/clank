<%= form_with(model: @game, local: true) do |form| %>
  <% if @game.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(@game.errors.count, "error") %> prohibited this game from being saved:</h2>

      <ul>
        <% @game.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <label class="form-control w-full max-w-xs">
    <div class="label">
      <span class="label-text">Name of game</span>
    </div>
    <%= form.text_field :title, required: true, class: "input input-bordered w-full max-w-xs", value: RandomNameGenerator.game_name %>
  </label>
  <% if (game_type = params.fetch(:game_type, 'clank')) == 'clank' %>
    <%= render 'clank/players/partials/form' %>
  <% elsif game_type == "aeons_end" %>
    <%= render 'aeons_end/players/partials/form' %>
  <% end %>

  <%= form.hidden_field :game_type, value: game_type %>

  <div class="actions mt-3">
    <button onclick="addPlayerBtn()" type="button" class="my-2 btn btn-primary btn-outline">Add Player</button>
    <%= form.submit class: "btn btn-active btn-primary" %>
  </div>
<% end %>
