<div class="stats glass mt-3" id='player-stats-<%= player['index'] %>'>
  <div class="stat">
    <div class="stat-figure text-primary text-[25px]">
      <%= render "aeons_end/players/components/icon_action", key: "turn_order" %>
    </div>
    <div class="stat-title text-sm">Turn order</div>
    <div class="stat-value text-primary text-base"><%= game.data['current_player_index'] %></div>
  </div>
  <%= render 'aeons_end/players/components/stat', player:, stat: 'attack_points', game_prefix: 'aeons_end' %>
  <%= render 'aeons_end/players/components/stat', player:, stat: 'skill_points', game_prefix: 'aeons_end' %>
  <div class="stat">
  <div class="stat-figure text-primary text-[25px]">
    <%= render "aeons_end/players/components/icon_action", key: 'slots'%>
  </div>
  <div class="stat-title text-sm"> Power up</div>
  <%# FIXME: fix below, breaks when player has no slots %>
  <div class="stat-value text-primary text-base"><%= player.fetch('slots', 0) %> / 4</div>
</div>

  <div class="stat">
    <div class="stat-figure text-primary text-[25px] relative group">
      <svg id="heart" width="42" height="42" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <clipPath id="heartClip">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41 0.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
          </clipPath>
        </defs>
        <rect
          id="redFill"
          width="100%"
          height="<%= height = ((player['health'].to_f / AeonsEnd::Model::Player::MAX_HEALTH) * 100) %>%"
          fill="red"
          clip-path="url(#heartClip)"
          y="<%= 100 - height %>%"
        />
        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41 0.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" stroke="red" fill="none"/>
      </svg>
      <div class="absolute top-[7px] right-0 left-[13px] text-base hidden group-hover:block cursor-default">
        <%= player['health'] %>
      </div>
    </div>
    <div class="stat-title text-sm">health</div>
  </div>
  <div class="stat">
    <div class="stat-figure text-primary text-[25px]">
      <%= render "aeons_end/players/components/icon_action", key: "gravehold" %>
    </div>
    <div class="stat-title text-sm">Gravehold</div>
    <div class="stat-value text-primary text-base"><%= game.data['gravehold'] %></div>
  </div>
  <div class="stat">
    <div class="stat-figure text-primary text-[25px]">
      <%= render "aeons_end/players/components/icon_action", key: "monster" %>
    </div>
    <div class="stat-title text-sm">Monster</div>
    <div class="stat-value text-primary text-base"><%= game.data['monster']['health'] %></div>
  </div>
</div>
