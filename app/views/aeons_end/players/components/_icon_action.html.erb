<%
  with_prefix = false if local_assigns[:with_prefix].nil?
  value = local_assigns[:value]
  case key
  when 'attack_points'
    icon = 'shield-halved'
    color = 'red'
  when 'gravehold'
    icon = 'sack-dollar'
    color = 'yellow'
  when 'skill_points'
    icon = 'wand-sparkles'
    color = 'sky'
  when 'turn_order'
    icon = 'face-sad-cry'
    color = 'sky'
  when 'slots'
    icon = 'face-sad-cry'
    color = 'sky'
  when 'health'
    icon = 'heart'
    color = 'red'
  when 'monster'
    icon = 'heart'
    color = 'red'
  else
    icon = nil
    color = nil
  end
%>
<% if icon %>
  <i class="text-<%= color %>-600 fa-solid fa-<%= icon %>"></i>
  <% if with_prefix %>
    <%= value.positive? ? "+#{value}" : value %>
  <% else %>
    <%= value %>
  <% end %>
<% end %>
