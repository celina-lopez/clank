<%
  label = case key
  when 'attack_points'
    'Attack'
  when 'move_points'
    'Move'
  when 'coins'
    'Coins'
  when 'skill_points'
    'Skill'
  when 'victory_points'
    'Victory'
  when 'slots'
    'Power up'
  when 'other_clank'
    "Other players give +#{value} clank"
  when 'replace_card_points'
    "Replace a card in the dungeon row"
  when 'draw'
    "Draw +#{value} cards"
  when 'cost'
    "Skill points"
  when 'health'
    "Health"
  else
    nil
  end
%>
<div>
  <% if label %>
    <%= render 'clank/players/components/icon_action', key:, value:, with_prefix: true %>
    <%= label %>
  <% else %>
    <%= key.humanize %>
  <% end %>
</div>
