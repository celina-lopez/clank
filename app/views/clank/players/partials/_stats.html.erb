<div class="stats glass mt-3" id='player-stats-<%= player['index'] %>'>
  <%= render 'players/components/stat', player:, stat: 'attack_points', game_prefix: 'clank' %>
  <%= render 'players/components/stat', player:, stat: 'move_points', game_prefix: 'clank' %>
  <%= render 'players/components/stat', player:, stat: 'skill_points', game_prefix: 'clank' %>
  <%= render 'players/components/stat', player:, stat: 'clank', game_prefix: 'clank' %>
  <%= render 'players/components/stat', player:, stat: 'health', game_prefix: 'clank' %>
  <%= render 'players/components/stat', player:, stat: 'coins', game_prefix: 'clank' %>
</div>
