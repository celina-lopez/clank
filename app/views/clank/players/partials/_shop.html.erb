<% 
  active_tile = game.data['map']['tiles'].find { |x| x['tile'].to_i == player['position']['current_position'].to_i }
  is_marketplace = active_tile.fetch('tags', []).include?('market')
%>
<div id='marketplace-id' class='<%= !is_marketplace && 'hidden'%>'>
  <div>
    Marketplace Active!
    <p>Each item cost 7 coins</p>
  </div>
  <%= render 'clank/players/partials/marketplace', player: %> 
</div>
