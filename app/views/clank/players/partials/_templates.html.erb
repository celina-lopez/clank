<template id='card-template'>
  <%= render 'players/components/card', game_prefix: 'clank' %>
</template>
<template id='circle-template'>
  <%= render 'players/components/circle', game_prefix: "clank" %>
</template>
<template id='stat-template'>
  <%= render 'players/components/stat', player: {'sample' => 1}, stat: 'sample', game_prefix: "clank" %>
</template>
<% %w[attack_points move_points coins skill_points clank victory_points health].each do |key| %>
  <template id='template-<%= key %>'>
    <%= render 'clank/players/components/icon_action', key: %>
  </template>
<% end %>
<template id='rewards-parent'>
  <div>Choose Rewards:</div>
    <div class="grid gap-4 grid-cols-3 auto-cols-auto	">
    </div>
  </div>
</template>
<template id='rewards-option'>
  <div
    onclick="executeAction(this)"
    class="card border border-2 rounded hover:bg-violet-200 cursor-pointer"
    data-type="redeem_reward"
    data-name="0,0"
  >
  </div>
</template>
<template id='trash-option-1'>
  <div>Trash</div>
  <% %w[active discarded].each do |key| %>
    <button
      onclick="executeAction(this)"
      class="btn btn-primary"
      data-type="trash"
    >
      Trash from <%= key.humanize %> Deck
    </button>
  <% end %>
</template>
<template id='trash-option-2'>
  <div>Choose a card to Trash from your Active or Discarded Deck:</div>
  <div>Active:</div>
  <div class='grid grid-cols-5 gap-1' id='active-trash-cards'>
  </div>
  <div>Discarded:</div>
  <div class='grid grid-cols-5 gap-1' id='discarded-trash-cards'>
  </div>
</template>
<template id='replace-cards'>
  <div>Replace a Card from the Dungeon Row:</div>
  <div class='grid grid-cols-5 gap-1' id='replace-active-cards'>
  </div>
</template>
<template id='health-stat'> 
  <div class="stat">
    <div class="stat-figure text-primary text-[25px] relative group">
      <svg id="heart" width="42" height="42" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <clipPath id="heartClip">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41 0.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
          </clipPath>
        </defs>
        <rect
          width="100%"
          height="100"
          fill="red"
          clip-path="url(#heartClip)"
          y="0"
        />
        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41 0.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" stroke="red" fill="none"/>
      </svg>
      <div
        class="absolute top-[7px] right-0 left-[13px] text-base hidden group-hover:block cursor-default"
      >
      </div>
    </div>
    <div class="stat-title text-sm">health</div>
  </div>
</template>
