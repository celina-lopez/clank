<style>
#boardgame {
  overflow: scroll;
  background-size: 100% 100%;
  height: 710px;
  width: 700px;
  overflow: auto; /* Enable scrolling for the game container */
  background-image: url(<%= @phaser_config['preload_images']['background'] %>);
}
</style>
<div class="grid grid-cols-2 lg:auto-cols-min">
  <div id='col-1' class="col-span-2 lg:col-span-1">
    <div>
      <%= render 'clank/players/partials/stats', player: %>
      <%= render 'clank/players/partials/instructions', player: %>
      <div id="infobox" class="mb-2">
      </div>
      <%= render 'clank/players/partials/rewards', player: %> 
      <%= render 'clank/players/partials/replace_card', player:, game: %> 
      <%= render 'clank/players/partials/trash_options', player: %>
      <%= render 'clank/players/partials/inventory', player: @player  %> 
      <%= render 'clank/players/partials/shop', player:, game: %> 
    </div>
    <div class="my-4 tabs p-0">
      <div class="tab border-b-2 border-b-primary" data-target="#panel1">Hand</div>
      <div class="tab" data-target="#panel2">Game Stats</div>
      <div class="tab" data-target="#panel3">Logs</div>
    </div>
    <div class="grid my-2">
      <div id="panel1" class="panel">
        <%= render 'clank/players/partials/current_hand', player:, game: %>
        <div class="mb-2 mt-3">Dungeon Row</div>
        <%= render 'clank/players/partials/active_deck', game:  %> 
        <div class="mb-2 mt-3">Reserves</div>
        <%= render 'clank/players/partials/reserves', game:  %> 
      </div>
       <div id="panel2" class="panel hidden">
          <div class="flex mt-2" style='align-items:center;'>
              <div class="mr-2 h-[10px] w-[10px] bg-primary"></div>
              Dragon 
            </div>
              <div class="stats glass" id='dragon-stats'>
                <div class="stat">
                  <div class="stat-figure text-primary text-[25px]">
                    <%= render "clank/players/components/icon_action", key: 'position' %>
                  </div>
                  <div class="stat-title text-sm">Dragon Strength</div>
                  <div class="stat-value text-primary text-base" id='dragon-position'>
                    <%= Clank::Model::Dragon::POSTION_ARRAY[@game.data.dig('dragon', 'position').to_i] %>
                  </div>
                </div>
                <div class="stat">
                  <div class="stat-figure text-primary text-[25px]">
                     <i class="text-black-600 fa-solid fa-face-sad-cry"></i>
                  </div>
                  <div class="stat-title text-sm">Clank</div>
                  <div class="stat-value text-primary text-base" id='dragon-clank'>
                    <%= @game.data.dig('dragon', 'clank').to_i %>
                  </div>
                </div>
              </div>
        <% game.data['players'].filter { |x| x['index'] != player['index'] }.map do |p| %>
          <div>
            <div class="flex mt-2" style='align-items:center;'>
              <div class="mr-2 h-[10px] w-[10px] bg-<%= @phaser_config.dig('player_colors', p['index'].to_i) %>-400"></div>
              <%= p['name'] %>
            </div>
            <%= render 'clank/players/partials/stats', player: p %>
          </div>
        <% end %>
      </div>
      <div id="panel3" class="panel hidden">
        <%= render 'players/partials/history', game: %> 
      </div>
    </div>
  </div>
  <div id='col-2'>
    <div id="boardgame"></div>
  </div>
</div>
<%= render 'clank/players/partials/templates' %>


<script>
  var config = {
    type: Phaser.AUTO,
    height: 710,
    width: 700,
    parent: 'boardgame',
    scene: {
        preload: preload,
        create: create
    },
    transparent: true,
  };

  var game = new Phaser.Game(config);
  var gameThiz;
  var dragonPositionArray = <%= raw Clank::Model::Dragon::POSTION_ARRAY %>;

  function preload() {
    <% @phaser_config['preload_images'].each do |name, source| %>
      this.load.image("<%= name %>", "<%= source %>");
    <% end %>
    <% @game.data['players'].each do |player| %>
      this.load.image("player<%= player['index'].to_i %>", "/images/player<%= player['index'].to_i %>.png");
    <% end %>
  };

  const descriptionArray = <%= @phaser_config['tagable_descriptions'].to_json.html_safe %>;
  const typeOfTileConfig = <%= @phaser_config['tiles'].to_json.html_safe %>;
  const playerColorConfig = <%= @phaser_config['game_player_colors'].to_json.html_safe %>;
  var mapTiles = <%= game.data.dig('map', 'tiles').to_json.html_safe %>;
  var tileSprites = []
  function generateTileMap() {
    var sprites = []
    mapTiles.forEach((tileData) => {
      if (tileData.tile < 0) return;
      let config = typeOfTileConfig[tileData.tags && tileData.tags[0] || 'default'] || typeOfTileConfig['default'];
      let size = config.size || 20;
      if (tileData.items && tileData.items.find(item => item.is_artifact)) {
        let artifact = tileData.items.find(item => item.is_artifact);
        if (artifact){
          if (artifact.name == 'artifact_banana') console.log(tileData)
          let overlay = gameThiz.add.sprite(tileData.frontend_data.x, tileData.frontend_data.y, artifact.name);
          overlay.setScale(0.09);
          tileSprites.push(overlay);
        }
      }
      let tile = gameThiz.add.rectangle(tileData.frontend_data.x, tileData.frontend_data.y, size, size, config.color);
      tile.setAlpha(0.1); 
      tile.setInteractive();

      // Create a graphics object for the popup background
      let popup = gameThiz.add.graphics();
      popup.fillStyle(0x000000, 0.8); // Black background with 80% opacity
      popup.fillRect(0, 0, 150, 100); // Set size of the popup
      popup.setVisible(false);

      // Create a text object for displaying tile info
      let infoText = gameThiz.add.text(10, 10, 'Hello', { font: '16px Arial', fill: '#ffffff' });
      infoText.setDepth(1);
      infoText.setVisible(false);

      tile.on('pointerover', function (pointer) {
        this.setAlpha(0.3);
        let info = Game.createDescriptionForTile(tileData);
        if (!info) return;
        infoText.setText(info);
        popup.setVisible(true);
        infoText.setVisible(true);

        // Calculate positions
        let popupX = pointer.x + 15;
        let popupY = pointer.y + 15;
        let infoTextX = pointer.x + 25;
        let infoTextY = pointer.y + 25;

        // Boundary checks for popup
        if (popupX + 150 > gameThiz.scale.width) {
          popupX = gameThiz.scale.width - 150;
          infoTextX = popupX + 10;
        }
        if (popupY + 100 > gameThiz.scale.height) {
          popupY = gameThiz.scale.height - 100;
          infoTextY = popupY + 10;
        }

        popup.setPosition(popupX, popupY);
        infoText.setPosition(infoTextX, infoTextY);

      });
      tile.on('pointerout', function () {
        this.setAlpha(0.1);
        popup.setVisible(false);
        infoText.setVisible(false);
      });
      tile.on('pointerdown', function () {
        window.app.action.send({ type:"move", value:`${tileData.tile}`, player_index: <%= player.dig('index') %>});
      });
      sprites.push(tile);
      sprites.push(popup);
      sprites.push(infoText);
    });
    return sprites;
  };
  let gamePlayers = []
  function addPlayerToMap(position, index){
    var playerPosition = mapTiles.find((tile) => tile.tile === position);
    var xOffset = ((index % 3) * 20) - 20;
    var yOffset =  (Math.floor(index / 3) * 20) - 20;
    let player = gameThiz.add.rectangle(playerPosition.frontend_data.x - xOffset, playerPosition.frontend_data.y + yOffset, 15, 15, playerColorConfig[index]);
    return player
  }

  function create() {
    gameThiz = this;
    tileSprites = generateTileMap();
    <% @game.data['players'].each do |player| %>
      gamePlayers.push(addPlayerToMap(<%= player['position']['current_position'].to_i %>, <%= player['index'].to_i %>));
    <% end %>
  }

  function executeAction(e) {
    let data = { type: e.dataset.type, player_index: <%= player.dig('index') %> }
    if (!!e.dataset.name) data.value = e.dataset.name
    window.app.action.send(data);
  }

  document.addEventListener('DOMContentLoaded', function () {
    HtmlActions.tabActions();
    HtmlActions.addHoverCardFunctions()
  });
</script>
