<div id="playerContainer">
  <label class="form-control w-full max-w-xs my-2">
    <div class="label">
      <span class="label-text">Name</span>
    </div>
    <input required="required" class="input input-bordered w-full max-w-xs" name="game[settings][players][]", value="<%= RandomNameGenerator.character_name %>">
  </label>
</div>
<template id="addPlayerForm">
  <label class="form-control w-full max-w-xs my-2">
    <div class="label">
      <span class="label-text">Name</span>
    </div>
    <input required="required" class="input input-bordered w-full max-w-xs" name="game[settings][players][]">
  </label>
</template>

<script>
  function addPlayerBtn() {
    let clone = document.importNode(document.getElementById('addPlayerForm').content, true)
    clone.querySelector('input').setAttribute('value', `Player ${document.querySelectorAll('input[name="game[players][]"]').length}`)
    clone.querySelector('input').setAttribute('value', generateName());
    document.getElementById('playerContainer').appendChild(clone);
  };

  const firstPart = <%= raw RandomNameGenerator::NAME_FIRST %>;
  const secondPart = <%= raw RandomNameGenerator::NAME_SECOND %>;
  function generateName () {
    const firstIndex = Math.floor(Math.random() * firstPart.length); 
    const secondIndex = Math.floor(Math.random() * secondPart.length); 
    return firstPart[firstIndex] + secondPart[secondIndex];
  }
</script>
