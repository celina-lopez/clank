<div role="alert" class="alert alert-error hidden" id="alert-popup">
  <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
  <span><span>
</div>
  <% if @game.data['end_game'] %>
    <%= render 'players/partials/end_game', game: @game %>
  <% else %>
    <div class="bg-<%= @phaser_config.dig('player_colors', @player['index'].to_i) %>-400 w-100 text-center">
      <% if @game.data['current_player_index'] == @player['index'] %>
        <h2 class="text-white">Your Turn</h2>
      <% else %>
        <h2 class="text-white">Player <%= @game.data['current_player_index'] %>'s Turn</h2>
      <% end %>
    </div>
    <div class="mx-2 overflow-hidden">
      <%= render 'players/partials/stats', player: @player %>
      <%= render 'players/partials/game', game: @game, player: @player %>
    </div>
  <% end %>
