<div id='disconnect-alert' class="hidden">
  <div role="alert" class="alert alert-warning my-2 place-self-center absolute top-[3px] left-0 right-0 max-w-fit">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-6 w-6 shrink-0 stroke-current"
      fill="none"
      viewBox="0 0 24 24">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
    </svg>
    <span>You have been disconnected from the game, please refresh the page to continue.</span>
  </div>
</div>
<div id='game-container'>
  <% if @game.data['end_game'] %>
    <%= render 'players/partials/end_game', game: @game %>
  <% else %>
    <%= render 'players/components/banner', game: @game, player: @player, phaser_config: @phaser_config %>
    <div class="mx-2 overflow-hidden">
      <%= render "#{@game.game_type}/players/partials/game", game: @game, player: @player %>
    </div>
  <% end %>
  <footer class="footer footer-center mt-3 text-base-content p-4">
  <aside class='flex'>
    <a href="/"><img src="/images/logo.png" class="w-10"></img></a>
    <p>Copyright © 2024 - All right reserved by Playboard.Games© </p>
  </aside>
</footer>
</div>
<script>
  const html = document.querySelector('html');
  const theme = localStorage.getItem('theme');
  if (theme) {
    html.dataset.theme = theme;
  }
</script>
