<%
  with_prefix = false if local_assigns[:with_prefix].nil?
  value = local_assigns[:value]
  # TODO: make colors better for icons
  case key
  when 'attack_points'
    icon = 'shield-halved'
    color = 'red-700'
  when 'move_points'
    icon = 'person-walking'
    color = 'amber-600'
  when 'coins'
    icon = 'sack-dollar'
    color = 'yellow-600'
  when 'skill_points'
    icon = 'wand-sparkles'
    color = 'sky-600'
  when 'clank'
    icon = 'face-sad-cry'
    color = 'sky-600'
  when 'victory_points'
    icon = 'face-smile'
    color = 'green-600'
  else
    icon = nil
    color = nil
  end

%>
<% if icon %>
  <i class="text-<%= color %> fa-solid fa-<%= icon %>"></i>
  <% if with_prefix %>
    <%= value.positive? ? "+#{value}" : value %>
  <% else %>
    <%= value %>
  <% end %>
<% end %>
