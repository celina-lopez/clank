<% 
  inventory = {} if local_assigns[:inventory].nil?
  action_type = nil if local_assigns[:action_type].nil?
  id = nil if local_assigns[:id].nil?
  inventory_name ||= inventory['name']
%>
<div class="relative card-parent">
  <div
    class="rounded-full trigger-button bg-red-100 border-black border-2 rounded h-[70px] w-[70px] cursor-pointer"
  >
    <img src='<%= inventory_name && "/images/#{inventory_name}.jpg" %>' class="rounded-full w-[70px]" />
  </div>
  <div class="modal-card fixed inset-0 z-10 flex items-center justify-center bg-black bg-opacity-50 hidden">
    <div class="bg-white px-8 py-4 rounded shadow-lg relative">
      <button class="closeButton absolute top-0 right-0 mt-2 mr-2 text-gray-500 hover:text-gray-700">
        &times;
      </button>
      <div class="rounded-t-lg bg-white"><%= inventory_name&.humanize %></div>
      <img src='/images/<%= inventory_name %>.jpg' class='h-[100px]'/>
      <div class="text-start action_parent">
        <% inventory.fetch('action', []).each do |action| %>
          <% action.each do |key, value| %>
            <%= render 'players/components/action', key:, value: %> 
          <% end %>
        <% end %>
        <% if inventory['victory_points'].present? %>
          <%= render 'players/components/action', key: 'victory_points', value: inventory['victory_points'] %> 
        <% end %>
      </div>
      <div><%= inventory['description'] %></div>
      <button
        onclick='executeAction(this)'
        data-name="<%= inventory['name'] %>"
        data-type="<%= action_type %>"
        class="btn btn-sm"
      >
      Play
        <button>
    </div>
  </div>
</div>
