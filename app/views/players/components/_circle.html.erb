<% 
  inventory = {} if local_assigns[:inventory].nil?
  action_type = nil if local_assigns[:action_type].nil?
  id = nil if local_assigns[:id].nil?
  inventory_name ||= inventory['name']
%>
<div class="mini_card relative"> 
  <div
    class="rounded-full trigger-button bg-red-100 border-black border-2 rounded h-[50px] w-[50px] cursor-pointer"
  >
    <img src='<%= inventory_name && "/images/#{inventory_name}.jpeg" %>' class="rounded-full w-[50px]" />
  </div>
  <div class='hidden_info_card absolute left-[85px] top-0 opacity-0 transition duration-300 delay-0'>
    <%= render(
      'players/components/info_card',
      card: local_assigns.fetch(:inventory, {}),
      data_type: action_type, 
      data_name: inventory_name, 
    ) %>
  </div>
</div>
