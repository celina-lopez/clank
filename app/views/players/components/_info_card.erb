<%
  card = {} if local_assigns[:card].nil?
  button_text = 'buy' if local_assigns[:button_text].nil?
%>
<div class='card card-side max-w-[400px] glass'>
  <figure><img src='/images/<%= card['name'] %>.jpeg' alt='<%= card['name'] %>' class="max-h-[100px]" /></figure>
  <div class='card-body p-3'>
    <h3 class='card-title'><%= card['name']&.humanize %></h3>
    <div class="text-start action_parent">
      <% card.fetch('actions', []).each_with_index do |action, index| %>
        <% action.each do |key, value| %>
          <%= render 'players/components/action', key:, value: %> 
          <% if (card.fetch('actions', []).size > 1 && index == 0) %>
            OR
            <br/>
          <% end%>
        <% end%>
      <% end %>
      <% card.fetch('acquire', []).each_with_index do |action, index| %>
        On Acquire:
        <br>
        <% action.each do |key, value| %>
          <%= render 'players/components/action', key:, value: %> 
        <% end %>
        <% if (card.fetch('acquire', []).size > 1 && index == 0) %>
          OR
          <br/>
        <% end%>
      <% end %>
      <% if card['victory_points'].present? %>
        <%= render 'players/components/action', key: 'victory_points', value: card['victory_points'] %> 
      <% end %>
      <% if card['cost'].present? %>
        <%= render 'players/components/action', key: 'cost', value: card['cost'] %>
      <% end %>
      <% if card['health'].present? %>
        <%= render 'players/components/action', key: 'health', value: card['health'] %>
      <% end %>
    </div>
    <div class="card-actions justify-end">
      <button
        onclick='executeAction(this)'
        data-type="<%= local_assigns[:data_type] %>"
        data-name="<%= local_assigns[:data_name] %>"
        class='btn btn-outline'
      >
        <%= button_text %>
      </button>
    </div>
  </div>
</div>
