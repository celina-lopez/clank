<% 
  card = {} if local_assigns[:card].nil?
  small_card = local_assigns[:small_card] || false
%>
<div
  <% if small_card %>
    class="card text-black card-compact bg-white shadow cursor-pointer h-[181px] w-[128px]"
    onclick='executeAction(this)'
    data-type="<%= local_assigns[:data_type] %>"
    data-name="<%= local_assigns[:data_name] %>"
  <% else %>
    class="card card-compact text-black bg-white shadow h-[265px]"
  <% end %>
>
  <figure><img src='<%= card['name'].present? && "/images/#{card['name']}.png" %>' alt="<%= card['name'] %>" class="<%= small_card ? "max-w-[130px]" : "max-w-[207px]" %>"/></figure>
  <div class='<%= small_card ? "px-[5px] py-[1px] h-[63px]" : "p-3 h-[136px]" %> relative' style="<%= small_card ? "font-size: 6px" : "font-size: 12px" %>">
    <div class="text-wrap <%= small_card ? "w-[65px]" : "w-[126px]" %> font-bold mt-1 gap-1 justify-center card_actions_parent">
      <% card.fetch('actions', []).each_with_index do |action, index| %>
        <% action.each do |key, value| %>
          <div><%= render "#{game_prefix}/players/components/action", key:, value: %></div>
          <% if (card.fetch('actions', []).size > 1 && index == 0) %>
            <div>OR</div>
          <% end %>
        <% end %>
      <% end %>
      <% card.fetch('action', []).each_with_index do |action, index| %>
        <% action.each do |key, value| %>
          <div><%= render "#{game_prefix}/players/components/action", key:, value: %></div>
          <% if (card.fetch('actions', []).size > 1 && index == 0) %>
            <div>OR</div>
          <% end %>
        <% end %>
      <% end %>
      <% card.fetch('acquire', []).each_with_index do |action, index| %>
        <div>On Acquire:</div>
        <% action.each do |key, value| %>
          <div>
            <%= render "#{game_prefix}/players/components/action", key:, value: %> 
          </div>
        <% end %>
        <% if (card.fetch('acquire', []).size > 1 && index == 0) %>
         <div>OR</div>
        <% end %>
      <% end %>
      <% card.fetch('conditions', []).each_with_index do |action, index| %>
        <% if action['type'] == 'can_buy' %>
          <div>Can ONLY <%= card['health'] ? 'attack' : 'buy' %> in <%= action['is_in'].humanize %></div>
        <% end %>
      <% end %>
      <% if card['victory_points'].present? %>
        <%= render "#{game_prefix}/players/components/action", key: 'victory_points', value: card['victory_points'] %> 
      <% end %>
      <% if card['description'].present? %>
        <div><%= card['description'] %></div>
      <% end %>
    </div>
    <div class="text-center absolute bottom-0 right-0 left-0 card_name"><%= card['name']&.humanize %></div>
    <% if card['cost'].present? %>
      <div class="bg-sky-600 px-1 text-white rounded-br absolute bottom-0 right-0"><%= card['cost'] %></div>
    <% end %>
    <% if card['health'].present? %>
      <div class="bg-red-600 px-1 text-white rounded-br absolute bottom-0 right-0"><%= card['health'] %></div>
    <% end %>
  </div>
</div>
