<%
  data_name = nil if local_assigns[:data_name].nil?
  data_type = nil if local_assigns[:data_type].nil?
%>
<div 
  class="card-parent relative flip-card"
  onclick='executeAction(this)'
  id='<%= id %>'
  data-type="<%= data_type %>"
  data-name="<%= data_name %>"
>
  <div class="flip-card-inner">
  <div
    class="flip-card-front rounded border-black border-2 rounded h-[150px] w-[127px] cursor-pointer"
  >
    <img src='/images/<%= card['name'] %>.jpeg' class="rounded-full text-center border-red-400 border h-[100px] mx-auto" />
    <div class="absolute w-[100%] bottom-[38px]">
      <div class="text-center mx-2 truncate rounded-t-lg border-red-500 border text-white bg-black"><%= card['name']&.humanize %></div>
    </div>
    <div class="font-bold mt-3 flex gap-1 justify-center">
      <% if card['actions']&.one? && card.dig('actions', 0, 'attack_points').present? %>
        <div>
          <i class="text-red-700 fa-solid fa-shield-halved"></i> <%= card.dig('actions', 0, 'attack_points') %>
        </div>
      <% end %>
      <% if card['actions']&.one? && card.dig('actions', 0, 'move_points').present? %>
        <i class="text-amber-600 fa-solid fa-person-walking"></i><%= card.dig('actions', 0, 'move_points') %>
      <% end %>
    </div>
    <% if card['cost'].present? %>
      <div class="bg-sky-600 px-1 rounded text-white absolute bottom-0 right-0"><%= card['cost'] %></div>
    <% end %>
    <% if card['health'].present? %>
      <div class="bg-red-600 px-1 rounded text-white absolute bottom-0 right-0"><%= card['health'] %></div>
    <% end %>
  </div>
  <div class="action-card flip-card-back border absolute border-black rounded border-2 h-[150px] w-[127px] ">
    <% card.fetch('actions', []).each_with_index do |action, index| %>
      <% action.each do |key, value| %>
        - <%= key.humanize %>: <%= value %>
        <br/>
      <% end %>
      <% if (card.fetch('actions', []).size > 1 && index == 0) %>
        OR
        <br/>
      <% end%>
    <% end %>
    <% card.fetch('acquire', []).each_with_index do |action, index| %>
      On Acquire:
      <br>
      <% action.each do |key, value| %>
        - <%= key.humanize %>: <%= value %>
        <br/>
      <% end %>
      <% if (card.fetch('acquire', []).size > 1 && index == 0) %>
        OR
        <br/>
      <% end%>
    <% end %>
    <% if card['victory_points'].present? %>
      Victory Points: <%= card['victory_points'] %>
      <br/>
    <% end %>
    <% if card['cost'].present? %>
      Skill points: <%= card['cost'] %>
    <% end %>
    <% if card['health'].present? %>
      Health: <%= card['health'] %>
    <% end %>
  </div>
  </div>
</div>
