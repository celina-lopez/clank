<% card = {} if local_assigns[:card].nil? %>
<div> 
  <div
    class="card card-compact glass cursor-pointer h-[230px]"
    onclick="toggleHiddenInfoCard(this)"
  >
    <figure><img src='<%= card['name'].present? && "/images/#{card['name']}.jpeg" %>' alt="<%= card['name'] %>" class="max-h-[150px]"/></figure>
    <div class='p-3 relative h-[80px] '>
      <div class="font-bold mt-2 flex gap-1 justify-center card_actions_parent">
        <% if card['actions']&.one? %>
          <% card.dig('actions', 0).each do |key, value| %>
            <div>
              <%= render 'players/components/icon_action', key:, value: %>
            </div>
          <% end %>
        <% end %>
      </div>
      <% if card['cost'].present? %>
        <div class="bg-sky-600 px-1 text-white rounded-br absolute bottom-0 right-0"><%= card['cost'] %></div>
      <% end %>
      <% if card['health'].present? %>
        <div class="bg-red-600 px-1 text-white rounded-br absolute bottom-0 right-0"><%= card['health'] %></div>
      <% end %>
      <div class="text-center card_name"><%= card['name']&.humanize %></div>
    </div>
  </div>
  <div class="mt-3 <%= !local_assigns[:selected] && 'invisible' %> infoselector">
    <div class="mx-auto border-x-[10px] border-x-transparent w-0 border-b-primary border-b-[10px] "></div>
    <div class="bg-primary h-[5px] rounded shadow shadow-primary/40"></div>
  </div>
  <div class='hidden_info_card hidden'>
    <%= render(
      'players/components/info_card',
      card:,
      data_type: local_assigns[:data_type], 
      data_name: local_assigns[:data_name],
      button_text: local_assigns[:button_text] 
    ) %>
  </div>
</div>
