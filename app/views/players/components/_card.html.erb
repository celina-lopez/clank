<% current_hand = false if local_assigns[:current_hand].nil? %>
<div class="card-parent relative">
  <div class="action-card invisible border absolute border-black rounded border-2 z-10 w-[300px] left-[100px] bg-white">
    <div class="text-center rounded-t-lg bg-white"><%= card['name']&.humanize %></div>
    <img src='/images/<%= card['name'] %>.jpeg' /> 
    <% card.fetch('actions', []).each_with_index do |action, index| %>
      <% action.each do |key, value| %>
        - <%= key.humanize %>: <%= value %>
        <br/>
      <% end %>
      <% if (card.fetch('actions', []).size > 1 && index == 0) %>
        OR
        <br/>
      <% end%>
    <% end %>
    <% card.fetch('acquire', []).each_with_index do |action, index| %>
      On Acquire:
      <br>
      <% action.each do |key, value| %>
        - <%= key.humanize %>: <%= value %>
        <br/>
      <% end %>
      <% if (card.fetch('acquire', []).size > 1 && index == 0) %>
        OR
        <br/>
      <% end%>
    <% end %>
    <% if card['victory_points'].present? %>
      Victory Points: <%= card['victory_points'] %>
      <br/>
    <% end %>
    <% if card['cost'].present? %>
      Skill points: <%= card['cost'] %>
    <% end %>
    <% if card['health'].present? %>
      Health: <%= card['health'] %>
    <% end %>
  </div>
  <div
    class="rounded bg-red-100 border-black border-2 rounded h-[150px] w-[127px] cursor-pointer"
    onclick='<%= current_hand ? 'executeCard(this)' : 'buyCard(this)' %>'
    id='<%= id %>'
    data-name="<%= card['name'] %>"
  >
    <div class="text-center rounded-t-lg bg-white"><%= card['name']&.humanize %></div>
      <div class="absolute">
        <% if card['actions']&.one? && card.dig('actions', 0, 'attack_points').present? %>
          <% card.dig('actions', 0, 'attack_points').times do %>
            <div class="rounded-full px-1 text-center bg-red-700">
              <i class="text-white fa-solid fa-shield-halved"></i>
            </div>
          <% end %>
        <% end %>
        <% if card['actions']&.one? && card.dig('actions', 0, 'move_points').present? %>
          <% card.dig('actions', 0, 'move_points').times do %>
            <div class="rounded-full bg-amber-600 text-center px-1">
              <i class="text-white fa-solid fa-person-walking"></i>
            </div>
          <% end %>
        <% end %>
      </div>
    <img src='/images/<%= card['name'] %>.jpeg' height="127"/>
    <% if card['cost'].present? %>
      <div class="bg-sky-600 px-1 rounded text-white absolute bottom-0 right-[-21px]"><%= card['cost'] %></div>
    <% end %>
  </div>
</div>
