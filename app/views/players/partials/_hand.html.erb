<% if player.dig('deck', 'active').empty? %>
  <button class="btn" onclick='executeAction(this)' data-type='end_turn'>End Turn</button>
<% else %>
  <button onclick='executeAction(this)' class="btn" data-type='play_all_cards' id="play_all_cards_button">Play all</button>
<% end %>
<div class='flex gap-3 flex-wrap items-strech' id='player-cards'>
  <% player.dig('deck', 'active').each do |card| %>
    <%= render(
      'players/components/card',
      card:,
      data_type: card['name'],
      button_text: 'play',
    ) %>
  <% end %>
</div>
