Current Hand
<div class='grid grid-cols-3 sm:grid-cols-5 md:grid-cols-6 xl:md:grid-cols-5 gap-1' id='player-cards'>
  <% player.dig('deck', 'active').each_with_index do |card, index| %>
    <%= render(
      'players/components/card',
      card:,
      id: "player-card-#{index}",
      data_type: card['name'],
      button_text: 'play'
    ) %>
  <% end %>
  <% if player.dig('deck', 'active').empty? %>
    <button class="btn" onclick='executeAction(this)' data-type='end_turn'>End Turn</button>
  <% end %>
</div>
