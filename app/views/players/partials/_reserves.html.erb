<div class='flex gap-3 flex-wrap place-items-stretch' id='marketplace-cards'>
  <% game.data.dig('marketplace').each_with_index do |card, index| %>
    <%= render(
      'players/components/card',
      card:,
      id: "marketplace-card-#{index}",
      data_type: 'buy_card',
      data_name: card['name'],
      button_text: card['health'].present? ? 'attack' : 'buy',
    ) %>
  <% end %>
</div>
