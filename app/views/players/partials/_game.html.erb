<div class="bg-blue-300 h-100"> 
  <div class="overflow-y-scroll h-[100vh]">
    <div id="boardgame"></div>
  </div>
</div>

<script>
  var config = {
    type: Phaser.AUTO,
    height: 710,
    width: 680,
    parent: 'boardgame',
    scene: {
        preload: preload,
        create: create
    }
};

var game = new Phaser.Game(config);

function preload() {
    this.load.image('background', "/images/sample_game.png");
    this.load.image('player', "/images/pawn.png");
}

function create() {
  var background = this.add.image(0, 0, 'background').setOrigin(0);
  background.setScale(.483);
  var tileSize = 20;
  var tileColor = 0xffffff;
  var tileAlpha = 0.5; // Transparency
  var tile = this.add.rectangle(tileSize + 20, tileSize, tileSize, tileSize, tileColor);
  tile.setOrigin(0);
  tile.setInteractive(); // Enable input events
  tile.on('pointerover', function () {
      this.setStrokeStyle(4, 0xffffff); // White border
      this.setAlpha(1); // Full opacity on hover
      this.setTint(0xffff00); // Glow effect
  });
  tile.on('pointerout', function () {
      this.setStrokeStyle(); // Remove border
      this.setAlpha(tileAlpha); // Restore transparency
      this.clearTint(); // Remove glow effect
  });
  // Add player
  var player = this.add.image(0, 0, 'player').setOrigin(0);
  player.setScale(.1);
}

function update() {
  console.log("nothing for now")
}

</script>
