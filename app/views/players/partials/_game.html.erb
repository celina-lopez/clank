<style>
#boardgame{
  overflow: scroll;
  background-size: 100% 100%;
  height: 710px;
  overflow: auto; /* Enable scrolling for the game container */
  background-image: url(<%= @phaser_config['preload_images']['background'] %>);
}
</style>
<% if game.data['current_player_index'] == player['index'] %>
  CURRENT_PLAYER: <%= player['index'] %>
<% end %>
<div role="tablist" class="tabs tabs-lifted bg-base-100 h-100 w-[700px]">
  <input type="radio" name="my_tabs_2" role="tab" class="tab" aria-label="Hand" checked />
  <div role="tabpanel" class="tab-content bg-base-100 border-base-300 rounded-box p-6 w-[700px] h-[100vh]">
    <%= render 'players/partials/current_hand', player:, game: %>
  </div>
  <input type="radio" name="my_tabs_2" role="tab" class="tab" aria-label="Map" />
  <div role="tabpanel" class="tab-content border-base-300 rounded-box p-6">
    <div class="overflow-y-scroll h-[100vh]">
      <div id="boardgame"></div>
    </div>
  </div>
  <input type="radio" name="my_tabs_2" role="tab" class="tab" aria-label="Dragon" />
  <div role="tabpanel" class="tab-content bg-base-100 border-base-300 rounded-box p-6 w-[700px] h-[100vh]">
    Dragon Position: <%= @game.data.dig('dragon', 'position') %> (<%= Model::Dragon::POSTION_ARRAY[@game.data.dig('dragon', 'position').to_i]%> cubes)
  </div>
  <input type="radio" name="my_tabs_2" role="tab" class="tab" aria-label="Chat" />
  <div role="tabpanel" class="tab-content bg-base-100 border-base-300 rounded-box p-6 w-[700px] h-[100vh]">
    <%= render 'players/partials/chat', player: %>
  </div>
   <input type="radio" name="my_tabs_2" role="tab" class="tab" aria-label="History" />
  <div role="tabpanel" class="tab-content bg-base-100 border-base-300 rounded-box p-6 w-[700px] h-[100vh]">
    TODO:  add history, see how a full game performs...
    TODO: Need to add history like dragon and extra on game engine 
    <% @game.history.each do |history| %>
      <div><%= raw history.to_json %></div>
    <% end %>
  </div>
</div>

<script>
  // TODO: get rid of console.log
  console.log(<%= raw @game.data.to_json %>)
  var config = {
    type: Phaser.AUTO,
    height: <%= @phaser_config.dig('config','height') %>,
    width: <%= @phaser_config.dig('config','width') %>,
    parent: 'boardgame',
    scene: {
        preload: preload,
        create: create
    },
    transparent: true,
  };

  var game = new Phaser.Game(config);

  function preload() {
    <% @phaser_config['preload_images'].each do |name, source| %>
      this.load.image("<%= name %>", "<%= source %>");
    <% end %>
    <% @game.data['players'].each do |player| %>
      this.load.image("player<%= player['index'].to_i %>", "/images/player<%= player['index'].to_i %>.png");
    <% end %>
  }

  const typeOfTileConfig = <%= @phaser_config['tiles'].to_json.html_safe %>;
  // var mapTiles = <%= game.data.dig('map', 'tiles').to_json.html_safe %>;
  // TODO: remove this map hack
  var mapTiles = <%= @temp_map_hack.to_json.html_safe %>;

  function generateTileMap(thiz) {
    mapTiles.forEach((tileData) => {
      let config = typeOfTileConfig[tileData.tags && tileData.tags[0] || 'default'] || typeOfTileConfig['default'];
      let size = config.size || 20;
      let tile = thiz.add.rectangle(size  + 20, size, size, size, config.color);
      tile.setOrigin(tileData.frontend_data.x, tileData.frontend_data.y);
      tile.setAlpha(0.8);
      tile.setInteractive(); 
      tile.on('pointerover', function () {
        this.setAlpha(1); // Full opacity on hover
      });
      tile.on('pointerout', function () {
        this.setAlpha(0.8); // Restore transparency
      });
      tile.on('pointerdown', function () {
        window.app.action.send({ type:"move", value:`${tileData.tile}`, player_index: <%= player.dig('index') %>});
      });
    });
  };
  const gamePlayers = {}
  function addPlayerToMap(thiz, position, index){
    var playerPosition = mapTiles.find((tile) => tile.tile === position);
    let config = typeOfTileConfig[playerPosition.tags && playerPosition.tags[0] || 'default'] || typeOfTileConfig['default'];
    let size = config.size || 20;
    var player = thiz.add.image(size + 20, size, "player" + index)
    gamePlayers[index] = player;
    player.setOrigin(playerPosition.frontend_data.x, playerPosition.frontend_data.y);
  }

  function create() {
    generateTileMap(this);
    <% @game.data['players'].each do |player| %>
      addPlayerToMap(this, <%= player['position']['current_position'].to_i %>, <%= player['index'].to_i %>);
    <% end %>
  }
</script>
