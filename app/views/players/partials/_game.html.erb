<style>
#boardgame{
  overflow: scroll;
  background-size: 100% 100%;
  height: 710px;
  width: 700px;
  overflow: auto; /* Enable scrolling for the game container */
  background-image: url(<%= @phaser_config['preload_images']['background'] %>);
}
</style>
<%= render 'players/partials/templates' %>
<div class="max-h-[50vh] overflow-auto mx-2">
  <%= render 'players/partials/stats', player: %>
  <div id="infobox" class="mb-2">
    <h3 class="mt-3">Select a card</h3>
  </div>
  <%= render 'players/partials/rewards', player: %> 
  <%= render 'players/partials/replace_card', player:, game: %> 
  <%= render 'players/partials/trash_options', player: %>
  <%= render 'players/partials/inventory', player: @player  %> 
  <%= render 'players/partials/shop', player:, game: %> 
</div>
<div>
  <div class="my-4 tabs p-0">
    <div class="tab border-b-2 border-b-primary " data-target="#panel1">Hand</div>
    <div class="tab" data-target="#panel2">Dungeon Row</div>
    <div class="tab" data-target="#panel3">Reserves</div>
    <div class="tab" data-target="#panel4">Map</div>
    <div class="tab" data-target="#panel5">Logs</div>
  </div>

  <div class="grid my-2">
    <div id="panel1" class="panel hidden">
      <%= render 'players/partials/current_hand', player:, game: %>
    </div>
    <div id="panel2" class="panel hidden">
      <%= render 'players/partials/active_deck', game:  %> 
    </div>
    <div id="panel3" class="panel hidden">
      <%= render 'players/partials/reserves', game:  %> 
    </div>
    <div id="panel4" class="panel ">
      <div class="overflow-y-scroll">
      Dragon Position: <%= @game.data.dig('dragon', 'position') %> (<%= Model::Dragon::POSTION_ARRAY[@game.data.dig('dragon', 'position').to_i]%> cubes)
        <div id="boardgame"></div>
      </div>
    </div>
    <div id="panel5" class="panel hidden">
      <%= render 'players/partials/history', game: %> 
    </div>
  </div>
</div>

<script>
  var config = {
    type: Phaser.AUTO,
    height: <%= @phaser_config.dig('config','height') %>,
    width: <%= @phaser_config.dig('config','width') %>,
    parent: 'boardgame',
    scene: {
        preload: preload,
        create: create
    },
    transparent: true,
  };

  var game = new Phaser.Game(config);

  function preload() {
    <% @phaser_config['preload_images'].each do |name, source| %>
      this.load.image("<%= name %>", "<%= source %>");
    <% end %>
    <% @game.data['players'].each do |player| %>
      this.load.image("player<%= player['index'].to_i %>", "/images/player<%= player['index'].to_i %>.png");
    <% end %>
  }
  const descriptionArray = <%= @phaser_config['tagable_descriptions'].to_json.html_safe %>;
  function createDescriptionForTile(tileData) {
    let description = `Tile Info: ${tileData.tile}\n`;
    tileData.tags && tileData.tags.forEach((tag) => {
      if (['artifact', 'major_item', 'minor_item', 'monkey'].includes(tag)) {
        description += `${tileData.items.length} ${tag.replace(/_/g, ' ')}(s)\n`;
      } else if (descriptionArray.includes(tag)) { 
        description += tag.
        replace(/_/g, ' ').
        replace(/(?: |\b)(\w)/g, function(key, _p1) { return key.toUpperCase() }) + '\n';
      }
    });
    return description;
  }


  const typeOfTileConfig = <%= @phaser_config['tiles'].to_json.html_safe %>;
  var mapTiles = <%= game.data.dig('map', 'tiles').to_json.html_safe %>;
  function generateTileMap(thiz) {
    mapTiles.forEach((tileData) => {
      if (tileData.tile < 0) return;
      let config = typeOfTileConfig[tileData.tags && tileData.tags[0] || 'default'] || typeOfTileConfig['default'];
      let size = config.size || 20;
      let tile = thiz.add.rectangle(size  + 20, size, size, size, config.color);
      tile.setOrigin(tileData.frontend_data.x, tileData.frontend_data.y);
      // TODO: add ending tiles on canva 
      tile.setAlpha(0.1); 
      tile.setInteractive(); 


    // Create a graphics object for the popup background
      let popup = thiz.add.graphics();
      popup.fillStyle(0x000000, 0.8); // Black background with 80% opacity
      popup.fillRect(0, 0, 150, 100); // Set size of the popup
      popup.setVisible(false);

      // Create a text object for displaying tile info
      let infoText = thiz.add.text(10, 10, 'Hello', { font: '16px Arial', fill: '#ffffff' });
      infoText.setDepth(1);
      infoText.setVisible(false);

      tile.on('pointerover', function (pointer) {
        this.setAlpha(0.3);
        console.log(tileData)
        let info = createDescriptionForTile(tileData);
        infoText.setText(info);
        popup.setVisible(true);
        infoText.setVisible(true);
        popup.setPosition(pointer.x + 15, pointer.y + 15);
        infoText.setPosition(pointer.x + 25, pointer.y + 25);

      });
      tile.on('pointerout', function () {
        this.setAlpha(0.1);
           popup.setVisible(false);
        infoText.setVisible(false);
      });
      tile.on('pointerdown', function () {
        window.app.action.send({ type:"move", value:`${tileData.tile}`, player_index: <%= player.dig('index') %>});
      });
    });
  };
  const gamePlayers = {}
  function addPlayerToMap(thiz, position, index){
    var playerPosition = mapTiles.find((tile) => tile.tile === position);
    let config = typeOfTileConfig[playerPosition.tags && playerPosition.tags[0] || 'default'] || typeOfTileConfig['default'];
    let size = config.size || 20;
    var player = thiz.add.image(size + 20, size, "player" + index)
    gamePlayers[index] = player;
    player.setOrigin(playerPosition.frontend_data.x, playerPosition.frontend_data.y);
  }

  function create() {
    generateTileMap(this);
    <% @game.data['players'].each do |player| %>
      addPlayerToMap(this, <%= player['position']['current_position'].to_i %>, <%= player['index'].to_i %>);
    <% end %>
  }

  document.addEventListener('DOMContentLoaded', function() {
    const buttons = document.querySelectorAll('.tab');
    const panels = document.querySelectorAll('.panel');
    buttons.forEach(button => {
      button.addEventListener('click', function () {
        const targetPanel = document.querySelector(button.getAttribute('data-target'));
        panels.forEach(function(panel) { panel.classList.add('hidden') });
        buttons.forEach(function(btn) {
          btn.classList.remove('border-b-2', 'border-b-primary');
        });

        targetPanel.classList.remove('hidden');
        button.classList.add('border-b-2', 'border-b-primary');
      });
    });
  });

  let infoBox = document.getElementById('infobox');

  function toggleHiddenInfoCard(element) {
    let parentElm = element.parentElement,
        hiddenInfoCard = parentElm.querySelector('.hidden_info_card');
    infoBox.innerHTML = hiddenInfoCard.innerHTML;
    document.querySelectorAll('.infoselector').forEach(function(card) {
      card.classList.add('invisible');
    });
    parentElm.querySelector('.infoselector').classList.remove('invisible');
  }
</script>
