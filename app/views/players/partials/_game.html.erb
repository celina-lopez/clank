<style>
#boardgame{
  overflow: scroll;
  background-size: 100% 100%;
  height: 710px;
  overflow: auto; /* Enable scrolling for the game container */
}
</style>

<div class="bg-blue-300 h-100 w-[700px]"> 
  <div class="overflow-y-scroll h-[100vh]">
    <div id="boardgame">
    </div>
  </div>
</div>
<script>
  var config = {
    type: Phaser.AUTO,
    height: 710,
    width: 700,
    parent: 'boardgame',
    scene: {
        preload: preload,
        create: create
    },
    transparent: true,
};

var game = new Phaser.Game(config);

function preload() {
    this.load.image('background', "/images/sample_game.png");
    this.load.image('player', "/images/pawn.png");
}
const typeOfTileConfig = {
  default: {
    size: 20, 
    color: 0xffffff,
  },
}
// TODO: populate from backend 
const mapTiles = [
  {x: 0, y: .9, type: 'default', index: 0},
  {x: 0, y: -1.7, type: 'default', index: 1},
  {x: -6, y: -1.7, type: 'default', index: 2},
  {x: -12, y: -1.7, type: 'default', index: 3},
  {x: -17, y: -1.7, type: 'default', index: 4},
  {x: -23, y: -1.5, type: 'default', index: 5},
  {x: 0, y: -6, type: 'default', index: 6},
]

function create() {
  this.add.image(0, 0, 'background').setOrigin(0).setScale(0.5);
  mapTiles.forEach((tileData) => {
    let config = typeOfTileConfig['default'];
    let tile = this.add.rectangle(config.size + 20, config.size, config.size, config.size, config.color);
    tile.setOrigin(tileData.x, tileData.y);
    tile.setInteractive(); 
    tile.on('pointerover', function () {
      this.setStrokeStyle(4, config.color); // White border
      this.setAlpha(1); // Full opacity on hover
    });
    tile.on('pointerout', function () {
      this.setStrokeStyle(); // Remove border
      this.setAlpha(0.5); // Restore transparency
    });
    tile.on('pointerdown', function () {
      console.log(`TODO: Game function here ${tileData.index}`)
    });
  });
  var player = this.add.image(0, 0, 'player').setOrigin(0);
  player.setScale(.1);
}

function update() {
  console.log("nothing for now")
}
</script>
