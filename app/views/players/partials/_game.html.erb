<style>
#boardgame{
  overflow: scroll;
  background-size: 100% 100%;
  height: 710px;
  overflow: auto; /* Enable scrolling for the game container */
}
</style>

<div class="bg-blue-300 h-100 w-[700px]"> 
  <div class="overflow-y-scroll h-[100vh]">
    <div id="boardgame">
    </div>
  </div>
</div>

<script>
  var config = {
    type: Phaser.AUTO,
    height: <%= @phaser_config.dig('config','height') %>,
    width: <%= @phaser_config.dig('config','width') %>,
    parent: 'boardgame',
    scene: {
        preload: preload,
        create: create
    },
    transparent: true,
  };

  var game = new Phaser.Game(config);

  function preload() {
    <% @phaser_config['preload_images'].each do |name, source| %>
      this.load.image("<%= name %>", "<%= source %>");
    <% end %>
  }

  const typeOfTileConfig = <%= @phaser_config['tiles'].to_json.html_safe %>;
  var mapTiles = <%= game.data.dig('map', 'tiles').to_json.html_safe %>;

  function generateTileMap(thiz) {
    mapTiles.forEach((tileData) => {
      let config = typeOfTileConfig[tileData.type || 'default'];
      let tile = thiz.add.rectangle(config.size + 20, config.size, config.size, config.size, config.color);
      tile.setOrigin(tileData.frontend_data.x, tileData.frontend_data.y);
      tile.setAlpha(.5);
      tile.setInteractive(); 
      tile.on('pointerover', function () {
        this.setAlpha(1); // Full opacity on hover
      });
      tile.on('pointerout', function () {
        this.setAlpha(0.5); // Restore transparency
      });
      tile.on('pointerdown', function () {
        window.app.action.send({ message: `Guess: ${tileData.tile}` });
      });
    });
  }

  function addPlayerToMap(thiz){
    var playerPosition = mapTiles.find((tile) => tile.tile === <%= player.dig('position', 'current_position').to_i %>);
    var player = thiz.add.image(playerPosition.x, playerPosition.y, 'player').setOrigin(0);
    player.setScale(.1);
  }

  function create() {
    this.add.image(0, 0, 'background').setOrigin(0).setScale(0.5);
    generateTileMap(this);
    addPlayerToMap(this);
  }
</script>
