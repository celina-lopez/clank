Active Deck 
<div class='grid grid-cols-5 grid-cols-3 sm:grid-cols-5 md:grid-cols-6 xl:md:grid-cols-5 gap-1' id='active-cards'>
  <% game.data.dig('deck', 'active').each_with_index do |card, index| %>
    <%= render(
      'players/components/card',
      card:,
      id: "active-card-#{index}",
      data_type: 'buy_card',
      data_name: card['name']
    ) %>
  <% end %>
</div>
