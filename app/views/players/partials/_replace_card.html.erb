<div class="<%= !player['replace_card_points'].positive? && 'hidden' %>" id='replace-card-id'>
  <div>Replace a Card from the Active Deck:</div>
  <div class='grid grid-cols-5 gap-1' id='replace-active-cards'>
    <% game.data.dig('deck', 'active').each_with_index do |card, index| %>
      <%= render(
        'players/components/card',
        card:,
        id: "replace-active-card-#{index}",
        data_type: 'replace_card',
        data_name: card['name'],
        button_text: 'replace'
      ) %>
    <% end %>
  </div>
</div>
