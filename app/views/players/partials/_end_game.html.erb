<div class="navbar bg-base-100">
  <a class="btn btn-ghost text-xl" href="/"><img src='/images/logo.png' width='30' />PlayBoard.Games</a>
</div>
<div class="mx-auto max-w-[500px] text-center">
  <div class="pr-10 mb-3">
    <a class="btn btn-primary" href="/games/new?game_type=<%= @game.game_type %>">Play again!</a>
  </div>
  <div class="pr-10 mb-3">
    <a href="https://www.facebook.com/sharer/sharer.php?u=<%= request.url %>" target="_blank"><i class="fa-brands fa-facebook"></i></a>
    <a href="https://twitter.com/intent/tweet?url=<%= request.url %>&text=Check%20out%20the%20endgame%20results%20of%20Clank!&via=ClankGame" target="_blank"><i class="fa-brands fa-square-x-twitter"></i></a>
  </div>
  <% @game.data['players'].sort_by { |player| -player['victory_points'].to_i }.each_with_index do |player, index| %>
    <div tabindex="<%= index %>" class="<%= player['results'].present? ? 'collapse collapse-arrow' : 'rounded-lg mb-2' %> border-primary border">
      <div class="collapse-title text-xl font-medium">
        <% if index == 0 %>
          <div class="w-100 text-center">
            <i class="fa-solid fa-trophy text-amber-400	text-5xl	"></i>
          </div>
          Winner!
        <% else %>
          <%=  (index + 1).ordinalize %> place
        <% end %>
        <div class="flex place-content-center" style="align-items: center;">
          <div class="h-[10px] mr-2 w-[10px] bg-<%= @phaser_config.dig('player_colors', player['index'].to_i) %>-400"></div>
          <div>
            Player <%= player['name'] %> 
          </div>
        </div>
        <%= player['victory_points'] %> victory points
      </div>
      <% if game.data['results'].present? %>
        <div class="collapse-content text-start">
          <% game.data['results'][player['index']].each do |point| %>
            <div><%= point['name'].humanize %>: <%= point['points'] %> points</div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
