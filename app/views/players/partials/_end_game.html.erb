<h1>Results</h1>
<% @game.data['players'].sort {|x| x['victory_points'] }.each_with_index do |player, index| %>
  <div>
    Player <%= player['index'] %>: <%= player['victory_points'] %> victory points <%= index == 0 ? "(Winner)" : "" %>
  </div>
<% end %>
<div>
  <a class="btn btn-primary" href="/games/new?game_type=clank">Play again!</a>
</div>
