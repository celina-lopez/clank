<template id='card-template'>
  <%= render 'players/components/card' %>
</template>
<template id='circle-template'>
  <%= render 'players/components/circle' %>
</template>
<% %w[attack_points move_points coins skill_points clank victory_points].each do |key| %>
  <template id='template-<%= key %>'>
    <%= render 'players/components/icon_action', key: %>
  </template>
<% end %>
<template id='rewards-parent'>
  <div>Choose Rewards:</div>
    <div class="grid gap-4 grid-cols-3 auto-cols-auto	">
    </div>
  </div>
</template>
<template id='rewards-option'>
  <div
    onclick="executeAction(this)"
    class="card border border-2 rounded hover:bg-violet-200 cursor-pointer"
    data-type="redeem_reward"
    data-name="0,0"
  >
  </div>
</template>
<template id='trash-option-1'>
  <div>Trash</div>
  <% %w[active discarded].each do |key| %>
    <button
      onclick="executeAction(this)"
      class="btn btn-primary"
      data-type="trash"
    >
      Trash from <%= key.humanize %> Deck
    </button>
  <% end %>
</template>
<template id='trash-option-2'>
  <div>Choose a card to Trash from your Active or Discarded Deck:</div>
  <div>Active:</div>
  <div class='grid grid-cols-5 gap-1' id='active-trash-cards'>
  </div>
  <div>Discarded:</div>
  <div class='grid grid-cols-5 gap-1' id='discarded-trash-cards'>
  </div>
</template>
<template id='replace-cards'>
  <div>Replace a Card from the Active Deck:</div>
  <div class='grid grid-cols-5 gap-1' id='replace-active-cards'>
  </div>
</template>
