  <div>
    <button id='end-turn' class="btn">End Turn</button>
  </div>
  Current Hand
  <div class='grid grid-cols-5 gap-1' id='player-cards'>
    <% player.dig('deck', 'active').each_with_index do |card, index| %>
      <%= render 'players/components/card', card:, id: "player-card-#{index}", current_hand: true %>
    <% end %>
  </div>
  <div id="inventory-id" class="<%= @player['inventory'].empty? && 'hidden' %>">
    Inventory
    <%= render 'players/partials/inventory', player: @player  %> 
  </div>
  <% 
    active_tile = @game.data['map']['tiles'].find { |x| x['tile'] == @player['position']['current_position'] }
    is_marketplace = active_tile.fetch('tags', []).include?('marketplace')
  %>
  <div id='marketplace-id' class='<%= !is_marketplace && 'hidden'%>'>
    <div>Marketplace Active</div>
    <%= render 'players/partials/marketplace', player: @player %> 
  </div>

  Active Deck 
  <div class='grid grid-cols-6 gap-1' id='active-cards'>
    <% game.data.dig('deck', 'active').each_with_index do |card, index| %>
      <%= render 'players/components/card', card:, id: "active-card-#{index}" %>
    <% end %>
  </div>
  Marketplace Cards
  <div class='grid grid-cols-4 gap-1' id='marketplace-cards'>
    <% game.data.dig('marketplace').each_with_index do |card, index| %>
      <%= render 'players/components/card', card:, id: "marketplace-card-#{index}" %>
    <% end %>
  </div>

<template id='card-template'>
  <%= render 'players/components/card', card: {}, id: "" %>
</template >
<script>
  function buyCard(e){
    window.app.action.send({ type: 'buy_card', value: e.dataset.name, player_index: <%= player.dig('index') %> });
  }
  function executeCard(e){
    window.app.action.send({ type: e.dataset.name, player_index: <%= player.dig('index') %> });
  }
  document.getElementById('end-turn').addEventListener('click', (e) => {
    window.app.action.send({ type: 'end_turn', player_index: <%= player.dig('index') %> });
  });
  function addListeningFunctionsToCards () {
    document.querySelectorAll('.card-parent').forEach((card) => {
      card.addEventListener('mouseover', (e) => {
        card.querySelector('.action-card').classList.remove('invisible');
      });
      card.addEventListener('mouseout', (e) => {
        card.querySelector('.action-card').classList.add('invisible');
      });
    });
  };
  addListeningFunctionsToCards();
</script>
