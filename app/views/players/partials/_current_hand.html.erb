<%= render 'players/partials/rewards', player: %> 
<%= render 'players/partials/replace_card', player:, game: %> 
<%= render 'players/partials/trash_options', player: %>
<%= render 'players/partials/hand', player: %> 
<%= render 'players/partials/inventory', player: @player  %> 
<%= render 'players/partials/shop', player:, game: %> 
<%= render 'players/partials/active_deck', game:  %> 
<%= render 'players/partials/reserves', game:  %> 

<script>
  function executeAction(e) {
    let data = { type: e.dataset.type, player_index: <%= player.dig('index') %> }
    if (!!e.dataset.name) data.value = e.dataset.name
    window.app.action.send(data);
  }
  function addCardTriggers() {
    document.querySelectorAll(".trigger-button").forEach(function (button) {
      button.addEventListener("click", function() {
        this.parentElement.parentElement.querySelector('.modal-card').classList.remove('hidden');
      });
    });

    document.querySelectorAll('.closeButton').forEach(function(button) {
      button.addEventListener('click', function() {
        this.parentElement.parentElement.classList.add('hidden');
      });
    });

    document.querySelectorAll('.modal-card').forEach(function (button) {
      button.addEventListener('click', function (e) {
        if (e.target.classList.contains('modal-card')) {
          e.target.classList.add('hidden');
        }
      });
    });
  }

  addCardTriggers();
</script>
